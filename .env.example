# Copy this to .env and fill in ONE AI provider section.
# Only GROQ_API_KEY (or another AI provider) is required — all job sources are optional bonuses.

# ── AI PROVIDER (pick one) ───────────────────────────────────────────────────

# Option 1: Groq — FREE, 14,400 req/day, very fast (RECOMMENDED)
# Get key in 30 seconds at: https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant   # default; llama-3.3-70b-versatile for better quality

# Option 2: Google Gemini — FREE, 1,500 req/day
# https://aistudio.google.com/app/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# Option 3: Ollama — 100% local & free (https://ollama.com)
# Run: ollama pull llama3.2  then start the server
# AI_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2
# OLLAMA_URL=http://localhost:11434/v1

# Option 4: Anthropic Claude (paid)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Option 5: OpenAI (paid)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── JOB SOURCES ──────────────────────────────────────────────────────────────

# Adzuna — free ~200 calls/day, great US coverage
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI — aggregates LinkedIn, Indeed, Glassdoor
# Free tier at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_JSEARCH_KEY=

# Google Jobs via SerpAPI — best coverage, aggregates all job boards + company pages
# 100 free searches/month at: https://serpapi.com (no credit card for free tier)
SERPAPI_KEY=
